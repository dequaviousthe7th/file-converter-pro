{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Converter Pro",
  "mainBinaryName": "file-converter-pro",
  "identifier": "com.dequavious.fileconverterpro",
  "version": "3.0.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "File Converter Pro",
        "width": 1100,
        "height": 740,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "externalBin": ["binaries/ffmpeg", "binaries/pandoc", "binaries/typst"],
    "resources": ["resources/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
